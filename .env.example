# API configuration: copy to apps/.env (or apps/api/.env for API-local overrides).
# API dev/start load root .env, apps/.env, then apps/api/.env.
# Restart bun run dev after editing environment files.
PORT=3000

# SQLite file for everything the API stores.
# SQLITE_PATH=/absolute/path/to/grugchug.sqlite   (default: apps/api/data/grugchug.sqlite)

# Conductor LLM providers. LLM_PROVIDER selects the first vendor ("gemini" or
# "groq", default gemini). If that vendor's flash retries and pro escalation
# all fail, the harness tries the other vendor when its key and both model
# names are set, then the fixture. The chosen vendor still needs all three of
# its values to start; a missing one fails that vendor's attempts. The API
# logs what it found at startup; `bun run --filter @grugchug/api check:llm`
# makes one real call per tier to confirm.
# Model names come from probing each vendor's /models endpoint, never typed
# from memory — see docs/plans or ask before changing them.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini
GEMINI_FLASH_MODEL=
GEMINI_PRO_MODEL=
GROQ_FLASH_MODEL=
GROQ_PRO_MODEL=
