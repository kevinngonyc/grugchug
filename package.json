{
  "name": "grugchug",
  "devDependencies": {
    "@biomejs/biome": "^2",
    "typescript": "^6"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "build": "bun run --filter './apps/*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "fmt": "biome check --write ."
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
